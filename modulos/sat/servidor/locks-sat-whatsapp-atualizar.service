[Unit]
Description=Locks SAT - atualiza o serviço do WhatsApp a partir do main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=locks-sat
WorkingDirectory=/home/locks-sat/whatsapp
# Download ou npm pendurado não pode segurar a atualização para sempre (a próxima hora tenta de novo).
TimeoutStartSec=15min
ExecStart=/home/locks-sat/whatsapp/atualizar.sh
# O "+" faz esta linha rodar como root (o reinício precisa): só reinicia se o script deixou o aviso .mudou.
# O try-restart não faz nada se o serviço estiver parado.
ExecStartPost=+/bin/sh -c 'if [ -f /home/locks-sat/whatsapp/.mudou ]; then rm -f /home/locks-sat/whatsapp/.mudou; systemctl try-restart locks-sat-whatsapp || true; fi'
